# Neon Postgres — database-neon-drizzle pattern
DATABASE_URL=       # pooled connection string (host ends in -pooler), used at runtime
DIRECT_URL=         # direct connection string (no -pooler), used only by drizzle-kit for migrations

# NextAuth v5 + Google OAuth — auth-google-oauth pattern
AUTH_SECRET=        # generate with: openssl rand -base64 32
AUTH_URL=            # http://localhost:3000 in dev; the production URL in prod
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Cloud Vision API — card recognition (object localization + OCR)
# Primary auth path: service-account JSON (required when the GCP org policy
# blocks plain API keys, which is common). Paste the ENTIRE contents of the
# downloaded service-account key file as a single-line value — most tools
# (Vercel env var UI/CLI, `.env` parsers) accept a raw JSON object with
# embedded "\n" escapes in private_key as-is; just paste the file's raw
# text, don't reformat it. See src/lib/recognition/visionClient.ts.
GOOGLE_VISION_SERVICE_ACCOUNT_JSON=
# Fallback auth path: plain API key, only usable if your GCP org policy
# allows creating API keys for the Cloud Vision API. Checked only if
# GOOGLE_VISION_SERVICE_ACCOUNT_JSON above is unset.
GOOGLE_VISION_API_KEY=

# Anthropic Claude API — value-estimation reasoning (with web search tool),
# and OCR-text interpretation for the Vision recognition flow (single
# non-agentic call, no web tools — see src/lib/recognition/claudeParseVisionText.ts)
ANTHROPIC_API_KEY=
ANTHROPIC_ESTIMATE_MODEL=   # optional override; defaults to claude-opus-4-8 in code (brief's stated default)
ANTHROPIC_PARSE_MODEL=      # optional override for the OCR-text-parsing call; defaults to claude-opus-4-8 in code

# eBay Sell API (Inventory + Offer + Taxonomy) — OAuth, official REST API only
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
EBAY_ENVIRONMENT=            # sandbox | production
EBAY_MERCHANT_LOCATION_KEY=  # required by the Offer API's merchantLocationKey field — set up an inventory location in Seller Hub / via the Location API first
# AES-256-GCM key used to encrypt ebay_accounts.access_token/.refresh_token
# at rest (src/lib/ebay/tokenEncryption.ts) — these grant live write access
# to a real eBay seller account. Must be 32 raw bytes, base64-encoded.
# Generate with: openssl rand -base64 32
# Rotating this key invalidates all stored eBay tokens (users must
# reconnect their eBay account via /api/ebay/oauth/start).
EBAY_TOKEN_ENCRYPTION_KEY=

# TCDB (Trading Card Database) API — NFL/NBA checklist reference data.
# UNRESOLVED (see plan.md §8): TCDB does not have a confirmed public REST
# API in this project's research — these vars are placeholders until real
# access is confirmed. lib/tcdb/client.ts throws a clear "not configured"
# error (501 from /api/tcdb/checklist) rather than fabricating data when
# these are unset.
TCDB_API_BASE_URL=
TCDB_API_KEY=

# PSA cert verification lookup — access unresolved, see brief.md/plan.md Open
# Questions. lib/recognition/psaCertLookup.ts is a stub adapter until this
# resolves; this var isn't read by any code yet (kept as a placeholder for
# whichever adapter implementation lands once access is confirmed).
PSA_API_KEY=
